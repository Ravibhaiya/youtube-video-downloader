# Port the server listens on (default 3000)
PORT=3000

# Which converter to use:
#   auto       yt-dlp on this server if installed, otherwise the third-party converter (default)
#   ytdlp      yt-dlp only, never contacts a third-party converter
#   converter  third-party converter only (cnvmp3.com)
ENGINE=auto

# Optional paths
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg

# If YouTube says "confirm you are not a bot", export cookies (Netscape format) and point to the file
# YTDLP_COOKIES=/path/to/cookies.txt

# Extra yt-dlp arguments, space separated
# YTDLP_ARGS=

# Where finished MP3 files wait to be downloaded (deleted after 2 hours)
# CACHE_DIR=/tmp/pulsedeck-mp3

# Longest video accepted, in seconds (default 21600 = 6 hours)
# MAX_VIDEO_SECONDS=21600

# How many videos convert at the same time (default 2)
# MAX_PARALLEL_CONVERSIONS=2

# Optional: path to ffprobe if it is not next to ffmpeg / on PATH (used to check the length of converted files)
# FFPROBE_PATH=/usr/bin/ffprobe
